{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
